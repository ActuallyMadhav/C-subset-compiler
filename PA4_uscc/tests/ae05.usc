// ae05.usc
// Diamond CFG with a kill on one arm only. The meet is an intersection, so the
// expression is NOT available at the merge even though one path preserves it.

int main() {
    int a;
    int b;
    int c;
    int x;

    a = 9;
    b = 4;
    c = 0;

    x = a + b;

    if (x > 10) {
        a = 1;
    } else {
        c = 1;
    }

    x = a + b;

    printf("%d %d\n", x, c);
    return 0;
}

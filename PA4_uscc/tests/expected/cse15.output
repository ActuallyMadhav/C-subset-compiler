; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [9 x i8] c"b first\0A\00"
@.str.1 = private unnamed_addr constant [15 x i8] c"a still first\0A\00"
@.str.2 = private unnamed_addr constant [9 x i8] c"a first\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  %0 = alloca i32, align 4
  %1 = alloca i32, align 4
  store i32 2, ptr %1, align 4
  store i32 8, ptr %0, align 4
  %2 = load i32, ptr %0, align 4
  %3 = load i32, ptr %1, align 4
  %lt = icmp slt i32 %3, %2
  br i1 %lt, label %if.then, label %if.end

if.then:                                          ; preds = %entry
  %4 = call i32 (ptr, ...) @printf(ptr @.str.2)
  br label %if.end

if.end:                                           ; preds = %if.then, %entry
  br i1 %lt, label %if.then2, label %if.end3

if.then2:                                         ; preds = %if.end
  %5 = call i32 (ptr, ...) @printf(ptr @.str.1)
  br label %if.end3

if.end3:                                          ; preds = %if.then2, %if.end
  %6 = load i32, ptr %1, align 4
  %7 = load i32, ptr %0, align 4
  %lt4 = icmp slt i32 %7, %6
  br i1 %lt4, label %if.then5, label %if.end6

if.then5:                                         ; preds = %if.end3
  %8 = call i32 (ptr, ...) @printf(ptr @.str)
  br label %if.end6

if.end6:                                          ; preds = %if.then5, %if.end3
  ret i32 0
}

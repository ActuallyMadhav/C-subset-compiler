; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [10 x i8] c"%d %d %d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  %0 = alloca i32, align 4
  %1 = alloca i32, align 4
  %2 = alloca i32, align 4
  %3 = alloca i32, align 4
  %4 = alloca i32, align 4
  %5 = alloca i32, align 4
  store i32 10, ptr %5, align 4
  store i32 4, ptr %4, align 4
  store i32 1, ptr %2, align 4
  store i32 0, ptr %1, align 4
  %6 = load i32, ptr %4, align 4
  %7 = load i32, ptr %5, align 4
  %add = add i32 %7, %6
  store i32 %add, ptr %0, align 4
  store i32 %add, ptr %3, align 4
  %8 = load i32, ptr %2, align 4
  %gt = icmp sgt i32 %8, 0
  br i1 %gt, label %if.then, label %if.else

if.then:                                          ; preds = %entry
  %9 = load i32, ptr %4, align 4
  %10 = load i32, ptr %5, align 4
  %sub2 = sub i32 %10, %9
  store i32 %sub2, ptr %1, align 4
  br label %if.end

if.end:                                           ; preds = %if.then, %if.else
  %11 = load i32, ptr %4, align 4
  %12 = load i32, ptr %5, align 4
  %sub3 = sub i32 %12, %11
  %13 = load i32, ptr %1, align 4
  %add4 = add i32 %13, %sub3
  store i32 %add4, ptr %1, align 4
  %14 = load i32, ptr %1, align 4
  %15 = load i32, ptr %0, align 4
  %16 = load i32, ptr %3, align 4
  %17 = call i32 (ptr, ...) @printf(ptr @.str, i32 %14, i32 %15, i32 %16)
  ret i32 0

if.else:                                          ; preds = %entry
  %18 = load i32, ptr %4, align 4
  %19 = load i32, ptr %5, align 4
  %sub = sub i32 %19, %18
  store i32 %sub, ptr %1, align 4
  br label %if.end
}

; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [7 x i8] c"%d %d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  %0 = alloca i32, align 4
  %1 = alloca i32, align 4
  %2 = alloca i32, align 4
  %arr = alloca [4 x i32], align 8
  %3 = getelementptr inbounds [4 x i32], ptr %arr, i32 0, i32 0
  store i32 1, ptr %2, align 4
  %4 = getelementptr inbounds i32, ptr %3, i32 1
  store i32 7, ptr %4, align 4
  %5 = load i32, ptr %4, align 4
  %add = add i32 %5, 2
  store i32 %add, ptr %1, align 4
  %6 = load i32, ptr %2, align 4
  %7 = getelementptr inbounds i32, ptr %3, i32 %6
  store i32 30, ptr %7, align 4
  %8 = load i32, ptr %4, align 4
  %add1 = add i32 %8, 2
  store i32 %add1, ptr %0, align 4
  %9 = load i32, ptr %1, align 4
  %10 = load i32, ptr %0, align 4
  %11 = call i32 (ptr, ...) @printf(ptr @.str, i32 %9, i32 %10)
  ret i32 0
}

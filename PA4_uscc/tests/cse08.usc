// cse08.usc
// The sum before the branch is plainly redundant and must be merged. The
// difference computed on both arms is not: availability is tracked per
// instruction, so the two computations are distinct entries and the meet at the
// merge intersects two disjoint sets. A value-numbering analysis would catch
// that one; an instruction-keyed one cannot.

int main() {
    int a;
    int b;
    int c;
    int x;
    int s;
    int t;

    a = 10;
    b = 4;
    c = 1;
    x = 0;

    s = a + b;
    t = a + b;

    if (c > 0) {
        x = a - b;
    } else {
        x = a - b;
    }

    x = x + (a - b);

    printf("%d %d %d\n", x, s, t);
    return 0;
}

// testing switch-case - 3
// test027.usc

int main(){
  int i;
  int b;
  int a;
  b = 0;
  switch (b) {
      case 0:
        b += 100;
        i = 0;
        a = b + 3000;
      case 10:
        b = b + 5000;
        i = 3333;
        i = b + 5000;
      case 30:
        b += 100;
        i = 0;
        i = b + 4000;
        break;
      default:
        b = b - 100;
        a = b + 5000;
  }
  return 0;
}

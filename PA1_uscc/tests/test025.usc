int main(){
  int i;
  int b;
  b = 0;
  switch (b) {
      case 0:
        b += 100;
        i = 0;
        i = b + 3000;
        break;
      case 10:
        b += 100;
        i = 0;
        i = b + 3000;
        break;
  }
  return 0;
}

// emit13.usc
// Tests an array initializer list, with an explicit and an
// inferred array size
// Expected output:
// 1 7
// 2 8
// 3 9
//---------------------------------------------------------
// Copyright (c) 2014, Sanjay Madhav
// All rights reserved.
//
// This file is distributed under the BSD license.
// See LICENSE.TXT for details.
//---------------------------------------------------------

int main()
{
	int a[3] = {1, 2, 3};
	int b[] = {7, 8, 9};
	int i = 0;
	
	while (i < 3)
	{
		printf("%d %d\n", a[i], b[i]);
		i = i + 1;
	}
	
	return 0;
}

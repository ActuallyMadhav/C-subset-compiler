// See LICENSE.TXT for details.
//---------------------------------------------------------

int main()
{
	char a[4] = {'h', 'i', '!', 0};
	char b[6] = {72, 101, 108, 108, 111, 0};
	
	printf("%s\n", a);
	printf("%s\n", b);
	printf("%d\n", a[0]);
	
	return 0;
}

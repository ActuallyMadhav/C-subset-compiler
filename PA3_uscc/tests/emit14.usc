// emit14.usc
// Tests that elements an initializer list doesn't supply are zero
// Expected output:
// 12000
// 000
//---------------------------------------------------------
// Copyright (c) 2014, Sanjay Madhav
// All rights reserved.
//
// This file is distributed under the BSD license.
// See LICENSE.TXT for details.
//---------------------------------------------------------

int main()
{
	int a[5] = {1, 2};
	int b[3] = {};
	int i = 0;
	
	while (i < 5)
	{
		printf("%d", a[i]);
		i = i + 1;
	}
	printf("\n");
	
	i = 0;
	while (i < 3)
	{
		printf("%d", b[i]);
		i = i + 1;
	}
	printf("\n");
	
	return 0;
}

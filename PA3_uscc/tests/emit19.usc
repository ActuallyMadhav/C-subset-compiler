// emit19.usc
// Tests reading and writing every element of a 2D array.
// Each element must have its own address: if two subscripts
// map to the same slot, later writes overwrite earlier ones
// Expected output:
// 0 1 2 3
// 10 11 12 13
// 20 21 22 23
//---------------------------------------------------------
// Copyright (c) 2014, Sanjay Madhav
// All rights reserved.
//
// This file is distributed under the BSD license.
// See LICENSE.TXT for details.
//---------------------------------------------------------

int main()
{
	int a[3][4];
	int i = 0;
	int j;
	
	while (i < 3)
	{
		j = 0;
		while (j < 4)
		{
			a[i][j] = i * 10 + j;
			j = j + 1;
		}
		i = i + 1;
	}
	
	i = 0;
	while (i < 3)
	{
		j = 0;
		while (j < 4)
		{
			printf("%d ", a[i][j]);
			j = j + 1;
		}
		printf("\n");
		i = i + 1;
	}
	
	return 0;
}

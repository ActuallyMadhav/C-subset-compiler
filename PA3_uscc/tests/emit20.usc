// emit20.usc
// Tests a 3D array, both subscripted and initialized
// Expected output:
// 0 123 12
// 1 6 8
//---------------------------------------------------------
// Copyright (c) 2014, Sanjay Madhav
// All rights reserved.
//
// This file is distributed under the BSD license.
// See LICENSE.TXT for details.
//---------------------------------------------------------

int main()
{
	int a[2][3][4];
	int b[2][2][2] = {{{1, 2}, {3, 4}}, {{5, 6}, {7, 8}}};
	int i = 0;
	int j;
	int k;
	
	while (i < 2)
	{
		j = 0;
		while (j < 3)
		{
			k = 0;
			while (k < 4)
			{
				a[i][j][k] = i * 100 + j * 10 + k;
				k = k + 1;
			}
			j = j + 1;
		}
		i = i + 1;
	}
	
	printf("%d %d %d\n", a[0][0][0], a[1][2][3], a[0][1][2]);
	printf("%d %d %d\n", b[0][0][0], b[1][0][1], b[1][1][1]);
	
	return 0;
}

int main(){
  int i = 0;
  int b;
  b = 3;
  switch (b) {
        case 1:
            printf("Monday\n");
            break;
        case 2:
            printf("Tuesday\n");
            break;
        case 3:
            printf("Wednesday\n");
            break;
   }
  return 0;
}

// All rights reserved.
//
// This file is distributed under the BSD license.
// See LICENSE.TXT for details.
//---------------------------------------------------------

int main()
{
	int e[2][3] = {{1, 2, 3}, {4, 5, 6}};
	
	printf("%d %d %d\n", e[0][0], e[0][1], e[0][2]);
	printf("%d %d %d\n", e[1][0], e[1][1], e[1][2]);
	
	return 0;
}

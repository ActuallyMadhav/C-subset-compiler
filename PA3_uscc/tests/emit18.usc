// emit18.usc
// Tests a 2D initializer list with the inner braces left out,
// and one where a row is only partly filled
// Expected output:
// 1 2 3
// 4 5 6
// 1 0 3 0
//---------------------------------------------------------
// Copyright (c) 2014, Sanjay Madhav
// All rights reserved.
//
// This file is distributed under the BSD license.
// See LICENSE.TXT for details.
//---------------------------------------------------------

int main()
{
	int e[2][3] = {1, 2, 3, 4, 5, 6};
	int f[2][2] = {{1}, {3}};
	
	printf("%d %d %d\n", e[0][0], e[0][1], e[0][2]);
	printf("%d %d %d\n", e[1][0], e[1][1], e[1][2]);
	printf("%d %d %d %d\n", f[0][0], f[0][1], f[1][0], f[1][1]);
	
	return 0;
}

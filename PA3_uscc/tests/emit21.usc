int main()
{
	char g[2][3] = {{'a', 'b', 0}, {'c', 'd', 0}};
	int i = 0;
	
	while (i < 2)
	{
		printf("%c%c\n", g[i][0], g[i][1]);
		i = i + 1;
	}
	
	printf("%d\n", g[1][1]);
	
	return 0;
}

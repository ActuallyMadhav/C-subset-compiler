// Byounguk Min (min87@purdue.edu)
// testing for statement parsing
// opt12.usc
// while + break + continue

int main(){
  int i = 0;
  int b;
  b = 0;
  while (i < 20) {
      ++i;
      if (i == 5) {
	  printf("continue\n");
          continue;
      }
      b = 100 + b;
      printf("%d\n", b);
      if (i == 15) {
	  printf("break\n");
          break;
      }
  }
  return 0;
}

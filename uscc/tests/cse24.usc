// cse24.usc
// The repeated product is redundant and must be merged. Two array parameters
// may name the same array, so the write through one of them may change what is
// read through the other, and the read after that write must survive.

int f(int p[], int q[]) {
    int x;
    int m;
    int n;
    int y;

    x = p[1] + 2;
    m = x * 3;
    n = x * 3;
    q[1] = 50;
    y = p[1] + 2;

    return m + n + y;
}

int main() {
    int arr[4];

    arr[1] = 7;
    printf("%d\n", f(arr, arr));
    return 0;
}

; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  %array = alloca [2 x i32], align 8
  %0 = getelementptr inbounds [2 x i32], ptr %array, i32 0, i32 0
  %1 = getelementptr inbounds i32, ptr %0, i32 0
  store i32 1, ptr %1, align 4
  %2 = getelementptr inbounds i32, ptr %0, i32 1
  store i32 10, ptr %2, align 4
  %3 = getelementptr inbounds i32, ptr %0, i32 1
  %4 = getelementptr inbounds i32, ptr %0, i32 0
  %5 = getelementptr inbounds i32, ptr %0, i32 0
  br label %for.cond

for.cond:                                         ; preds = %for.step, %entry
  %Phi = phi i32 [ %inc, %for.step ], [ 0, %entry ]
  %lt = icmp slt i32 %Phi, 4
  br i1 %lt, label %for.body, label %for.end

for.body:                                         ; preds = %for.cond
  %6 = load i32, ptr %3, align 4
  %7 = load i32, ptr %4, align 4
  %add = add i32 %7, %6
  store i32 %add, ptr %5, align 4
  br label %for.step

for.step:                                         ; preds = %for.body
  %inc = add i32 %Phi, 1
  br label %for.cond

for.end:                                          ; preds = %for.cond
  %8 = getelementptr inbounds i32, ptr %0, i32 0
  %9 = load i32, ptr %8, align 4
  %10 = call i32 (ptr, ...) @printf(ptr @.str, i32 %9)
  ret i32 0
}

; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  %0 = alloca i32, align 4
  %1 = alloca i32, align 4
  %2 = alloca i32, align 4
  %3 = alloca i32, align 4
  %4 = alloca i32, align 4
  store i32 5, ptr %4, align 4
  store i32 2, ptr %3, align 4
  store i32 0, ptr %0, align 4
  store i32 0, ptr %1, align 4
  store i32 0, ptr %2, align 4
  br label %while.cond

while.cond:                                       ; preds = %switch.end, %entry
  %5 = load i32, ptr %1, align 4
  %lt = icmp slt i32 %5, 4
  br i1 %lt, label %while.body, label %while.end

while.body:                                       ; preds = %while.cond
  %6 = load i32, ptr %3, align 4
  %7 = load i32, ptr %4, align 4
  %mul = mul i32 %7, %6
  store i32 %mul, ptr %2, align 4
  %8 = load i32, ptr %1, align 4
  switch i32 %8, label %switch.default [
    i32 0, label %switch.case
    i32 1, label %switch.case1
  ]

while.end:                                        ; preds = %while.cond
  %9 = load i32, ptr %0, align 4
  %10 = call i32 (ptr, ...) @printf(ptr @.str, i32 %9)
  ret i32 0

switch.end:                                       ; preds = %switch.default, %switch.case1, %switch.case
  %11 = load i32, ptr %1, align 4
  %add5 = add i32 %11, 1
  store i32 %add5, ptr %1, align 4
  br label %while.cond

switch.case:                                      ; preds = %while.body
  %12 = load i32, ptr %0, align 4
  %add = add i32 %12, %mul
  store i32 %add, ptr %0, align 4
  br label %switch.end

switch.case1:                                     ; preds = %while.body
  %13 = load i32, ptr %2, align 4
  %14 = load i32, ptr %0, align 4
  %add3 = add i32 %14, %13
  store i32 %add3, ptr %0, align 4
  br label %switch.end

switch.default:                                   ; preds = %while.body
  %15 = load i32, ptr %0, align 4
  %add4 = add i32 %15, 1
  store i32 %add4, ptr %0, align 4
  br label %switch.end
}

; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [16 x i8] c"%d %d %d %d %d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  %0 = alloca i32, align 4
  %1 = alloca i32, align 4
  %2 = alloca i32, align 4
  %3 = alloca i32, align 4
  %4 = alloca i32, align 4
  %5 = alloca i32, align 4
  %6 = alloca i32, align 4
  store i32 8, ptr %6, align 4
  store i32 2, ptr %5, align 4
  %7 = load i32, ptr %5, align 4
  %8 = load i32, ptr %6, align 4
  %sub = sub i32 %8, %7
  store i32 %sub, ptr %3, align 4
  store i32 %sub, ptr %4, align 4
  %9 = load i32, ptr %6, align 4
  %10 = load i32, ptr %5, align 4
  %sub2 = sub i32 %10, %9
  store i32 %sub2, ptr %2, align 4
  %11 = load i32, ptr %5, align 4
  %12 = load i32, ptr %6, align 4
  %div = sdiv i32 %12, %11
  store i32 %div, ptr %1, align 4
  %13 = load i32, ptr %6, align 4
  %14 = load i32, ptr %5, align 4
  %div3 = sdiv i32 %14, %13
  store i32 %div3, ptr %0, align 4
  %15 = load i32, ptr %3, align 4
  %16 = load i32, ptr %4, align 4
  %17 = load i32, ptr %2, align 4
  %18 = load i32, ptr %1, align 4
  %19 = load i32, ptr %0, align 4
  %20 = call i32 (ptr, ...) @printf(ptr @.str, i32 %15, i32 %16, i32 %17, i32 %18, i32 %19)
  ret i32 0
}

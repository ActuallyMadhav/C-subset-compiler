; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @f(ptr %p, ptr %q) {
entry:
  %0 = alloca i32, align 4
  %1 = alloca i32, align 4
  %2 = alloca i32, align 4
  %3 = alloca i32, align 4
  %4 = alloca ptr, align 8
  store ptr %q, ptr %4, align 8
  %5 = alloca ptr, align 8
  store ptr %p, ptr %5, align 8
  %6 = load ptr, ptr %5, align 8
  %7 = getelementptr inbounds i32, ptr %6, i32 1
  %8 = load i32, ptr %7, align 4
  %add = add i32 %8, 2
  store i32 %add, ptr %3, align 4
  %9 = load i32, ptr %3, align 4
  %mul = mul i32 %9, 3
  store i32 %mul, ptr %2, align 4
  store i32 %mul, ptr %1, align 4
  %10 = load ptr, ptr %4, align 8
  %11 = getelementptr inbounds i32, ptr %10, i32 1
  store i32 50, ptr %11, align 4
  %12 = load ptr, ptr %5, align 8
  %13 = getelementptr inbounds i32, ptr %12, i32 1
  %14 = load i32, ptr %13, align 4
  %add2 = add i32 %14, 2
  store i32 %add2, ptr %0, align 4
  %15 = load i32, ptr %0, align 4
  %16 = load i32, ptr %1, align 4
  %17 = load i32, ptr %2, align 4
  %add3 = add i32 %17, %16
  %add4 = add i32 %add3, %15
  ret i32 %add4
}

define i32 @main() {
entry:
  %arr = alloca [4 x i32], align 8
  %0 = getelementptr inbounds [4 x i32], ptr %arr, i32 0, i32 0
  %1 = getelementptr inbounds i32, ptr %0, i32 1
  store i32 7, ptr %1, align 4
  %call = call i32 @f(ptr %0, ptr %0)
  %2 = call i32 (ptr, ...) @printf(ptr @.str, i32 %call)
  ret i32 0
}

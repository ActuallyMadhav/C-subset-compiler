; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [7 x i8] c"%d %d\0A\00"

declare i32 @printf(ptr, ...)

define void @bump(ptr %a) {
entry:
  %0 = alloca ptr, align 8
  store ptr %a, ptr %0, align 8
  %1 = load ptr, ptr %0, align 8
  %2 = getelementptr inbounds i32, ptr %1, i32 1
  store i32 100, ptr %2, align 4
  ret void
}

define i32 @main() {
entry:
  %0 = alloca i32, align 4
  %1 = alloca i32, align 4
  %arr = alloca [4 x i32], align 8
  %2 = getelementptr inbounds [4 x i32], ptr %arr, i32 0, i32 0
  %3 = getelementptr inbounds i32, ptr %2, i32 1
  store i32 7, ptr %3, align 4
  %4 = load i32, ptr %3, align 4
  %add = add i32 %4, 2
  store i32 %add, ptr %1, align 4
  call void @bump(ptr %2)
  %5 = load i32, ptr %3, align 4
  %add1 = add i32 %5, 2
  store i32 %add1, ptr %0, align 4
  %6 = load i32, ptr %1, align 4
  %7 = load i32, ptr %0, align 4
  %8 = call i32 (ptr, ...) @printf(ptr @.str, i32 %6, i32 %7)
  ret i32 0
}

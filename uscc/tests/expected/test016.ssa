; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"
@.str.1 = private unnamed_addr constant [4 x i8] c"%d,\00"

declare i32 @printf(ptr, ...)

define void @printArray(ptr %array, i32 %size) {
entry:
  br label %while.cond

while.cond:                                       ; preds = %while.body, %entry
  %Phi1 = phi i32 [ %inc, %while.body ], [ 0, %entry ]
  %sub = sub i32 %size, 1
  %lt = icmp slt i32 %Phi1, %sub
  br i1 %lt, label %while.body, label %while.end

while.body:                                       ; preds = %while.cond
  %0 = getelementptr inbounds i32, ptr %array, i32 %Phi1
  %1 = load i32, ptr %0, align 4
  %2 = call i32 (ptr, ...) @printf(ptr @.str.1, i32 %1)
  %inc = add i32 %Phi1, 1
  br label %while.cond

while.end:                                        ; preds = %while.cond
  %3 = getelementptr inbounds i32, ptr %array, i32 %Phi1
  %4 = load i32, ptr %3, align 4
  %5 = call i32 (ptr, ...) @printf(ptr @.str, i32 %4)
  ret void
}

define i32 @main() {
entry:
  %array = alloca [5 x i32], align 8
  %0 = getelementptr inbounds [5 x i32], ptr %array, i32 0, i32 0
  %1 = getelementptr inbounds i32, ptr %0, i32 0
  store i32 1, ptr %1, align 4
  %2 = getelementptr inbounds i32, ptr %0, i32 1
  store i32 1, ptr %2, align 4
  %3 = getelementptr inbounds i32, ptr %0, i32 2
  store i32 2, ptr %3, align 4
  %4 = getelementptr inbounds i32, ptr %0, i32 3
  store i32 3, ptr %4, align 4
  %5 = getelementptr inbounds i32, ptr %0, i32 4
  store i32 5, ptr %5, align 4
  call void @printArray(ptr %0, i32 5)
  %6 = call i32 (ptr, ...) @printf(ptr @.str, i32 10)
  ret i32 0
}

; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [13 x i8] c"%d %d %d %d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  %0 = alloca i32, align 4
  %1 = alloca i32, align 4
  %2 = alloca i32, align 4
  %3 = alloca i32, align 4
  %4 = alloca i32, align 4
  %5 = alloca i32, align 4
  %6 = alloca i32, align 4
  store i32 9, ptr %6, align 4
  store i32 4, ptr %5, align 4
  store i32 3, ptr %4, align 4
  %7 = load i32, ptr %5, align 4
  %8 = load i32, ptr %6, align 4
  %sub = sub i32 %8, %7
  store i32 %sub, ptr %3, align 4
  %9 = load i32, ptr %4, align 4
  %10 = load i32, ptr %6, align 4
  %mul = mul i32 %10, %9
  store i32 %mul, ptr %2, align 4
  store i32 %sub, ptr %1, align 4
  store i32 %mul, ptr %0, align 4
  %11 = load i32, ptr %3, align 4
  %12 = load i32, ptr %2, align 4
  %13 = load i32, ptr %1, align 4
  %14 = load i32, ptr %0, align 4
  %15 = call i32 (ptr, ...) @printf(ptr @.str, i32 %11, i32 %12, i32 %13, i32 %14)
  ret i32 0
}

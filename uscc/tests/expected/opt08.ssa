; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [6 x i8] c"%d - \00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  br label %for.cond

for.cond:                                         ; preds = %for.step, %entry
  %Phi = phi i32 [ %add2, %for.step ], [ 0, %entry ]
  %Phi1 = phi i32 [ %add, %for.step ], [ 0, %entry ]
  %lt = icmp slt i32 %Phi, 20
  br i1 %lt, label %for.body, label %for.end

for.body:                                         ; preds = %for.cond
  %add = add i32 100, %Phi1
  %0 = call i32 (ptr, ...) @printf(ptr @.str, i32 %add)
  br label %for.step

for.step:                                         ; preds = %for.body
  %add2 = add i32 %Phi, 1
  br label %for.cond

for.end:                                          ; preds = %for.cond
  ret i32 0
}

; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  br label %dowhile.body

dowhile.body:                                     ; preds = %dowhile.cond, %entry
  %Phi = phi i32 [ %inc, %dowhile.cond ], [ 0, %entry ]
  %Phi1 = phi i32 [ %add, %dowhile.cond ], [ 0, %entry ]
  %inc = add i32 %Phi, 1
  %add = add i32 100, %Phi1
  %0 = call i32 (ptr, ...) @printf(ptr @.str, i32 %add)
  br label %dowhile.cond

dowhile.cond:                                     ; preds = %dowhile.body
  %lt = icmp slt i32 %inc, 20
  br i1 %lt, label %dowhile.body, label %dowhile.end

dowhile.end:                                      ; preds = %dowhile.cond
  ret i32 0
}

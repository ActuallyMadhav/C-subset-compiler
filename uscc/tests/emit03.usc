int main() {
    int x = 3;
    int i = 0;
    int result = 0;
    int y = 6;
    while (i < 5) {
        result = x + result;
        i = i + 1;
        if (x == 3) {
            result = result + 10;
        }
    }
    printf("%d\n", result);
    return 0;
}


// ae07.usc
// Nested loops. The invariant reaches the inner body across two back edges;
// the variable the outer loop updates kills the expression that reads it.

int main() {
    int a;
    int b;
    int i;
    int j;
    int sum;

    a = 2;
    b = 6;
    sum = 0;
    i = 0;

    while (i < 3) {
        j = 0;
        while (j < 2) {
            sum = sum + (a * b);
            j = j + 1;
        }
        i = i + 1;
    }

    printf("%d\n", sum);
    return 0;
}

// ae09.usc
// Comparisons are expressions too. The loop condition is a CmpInst, and it is
// killed inside the body by the update to its operand.

int main() {
    int i;
    int n;
    int hits;

    i = 0;
    n = 5;
    hits = 0;

    while (i < n) {
        if (i < 3) {
            hits = hits + 1;
        }
        i = i + 1;
    }

    printf("%d\n", hits);
    return 0;
}

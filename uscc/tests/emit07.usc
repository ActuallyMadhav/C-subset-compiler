// See LICENSE.TXT for details.
//---------------------------------------------------------


int main() {
    int x = 5;
    int y;
    if (x == 5) {
        y = 1;
        while (y < 5) {
            y = y + 1;
        }
    } else {
        y = 0;
    }
    printf("%d\n", y);
    return 0;
}


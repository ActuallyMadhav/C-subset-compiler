// cse17.usc
// Addition and multiplication read the same whichever way round the operands
// are written, so the second form of each is redundant and must be replaced by
// the first.

int main() {
    int a;
    int b;
    int w;
    int x;
    int y;
    int z;

    a = 4;
    b = 6;

    w = a + b;
    x = b + a;
    y = a * b;
    z = b * a;

    printf("%d %d %d %d\n", w, x, y, z);
    return 0;
}

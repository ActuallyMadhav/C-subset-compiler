// opt10.usc
// for + continue + break

int main(){
  int i;
  int b;
  b = 0;
  for (i = 0; i < 20; i = i + 1) {
      if (i % 3 == 0) {
	  printf("continue\n");
          continue;
      }
      b = 100 + b;
      printf("%d\n", b);
      if (i == 10) {
	  printf("break\n");
          break;
      }
      else {
	  continue;
      }
      printf("onemore\n");
  }
  return 0;
}

// cse09.usc
// Comparisons are expressions, so a repeated comparison is redundant too.
// This is the case that distinguishing predicates must not break.

int main() {
    int i;
    int n;
    int p;
    int q;

    i = 2;
    n = 7;

    p = 0;
    q = 0;

    if (i < n) {
        p = 1;
    }
    if (i < n) {
        q = 1;
    }

    printf("%d %d\n", p, q);
    return 0;
}

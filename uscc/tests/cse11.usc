// cse11.usc
// Redundancy local to a block that is not the entry block. The comparison in
// the entry block reaches this one, so its IN set is not empty; the repeated
// product must still be found among the expressions computed here.

int main() {
    int a;
    int b;
    int n;
    int x;
    int y;

    a = 4;
    b = 6;
    n = 3;

    if (n > 0) {
        x = a * b;
        y = a * b;
        printf("%d %d\n", x, y);
    }

    return 0;
}

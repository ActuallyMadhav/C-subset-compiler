; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [7 x i8] c"break\0A\00"
@.str.1 = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  br label %for.cond

for.cond:                                         ; preds = %for.step, %entry
  %Phi = phi i32 [ %add2, %for.step ], [ 0, %entry ]
  %Phi1 = phi i32 [ %add, %for.step ], [ 0, %entry ]
  %lt = icmp slt i32 %Phi, 20
  br i1 %lt, label %for.body, label %for.end

for.body:                                         ; preds = %for.cond
  %add = add i32 100, %Phi1
  %0 = call i32 (ptr, ...) @printf(ptr @.str.1, i32 %add)
  %eq = icmp eq i32 %Phi, 10
  br i1 %eq, label %if.then, label %if.end

for.step:                                         ; preds = %if.end
  %add2 = add i32 %Phi, 1
  br label %for.cond

for.end:                                          ; preds = %if.then, %for.cond
  ret i32 0

if.then:                                          ; preds = %for.body
  %1 = call i32 (ptr, ...) @printf(ptr @.str)
  br label %for.end

if.end:                                           ; preds = %for.body
  br label %for.step
}

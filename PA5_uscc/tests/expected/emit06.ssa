; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [4 x i8] c"%c\0A\00"
@.str.1 = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  %0 = call i32 (ptr, ...) @printf(ptr @.str.1, i1 true)
  %1 = call i32 (ptr, ...) @printf(ptr @.str.1, i32 97)
  %2 = call i32 (ptr, ...) @printf(ptr @.str, i32 98)
  %3 = call i32 (ptr, ...) @printf(ptr @.str, i32 97)
  ret i32 0
}

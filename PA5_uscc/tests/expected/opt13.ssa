; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [7 x i8] c"break\0A\00"
@.str.1 = private unnamed_addr constant [4 x i8] c"%d\0A\00"
@.str.2 = private unnamed_addr constant [10 x i8] c"continue\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  br label %while.cond

while.cond:                                       ; preds = %if.end4, %if.then, %entry
  %Phi = phi i32 [ %inc, %if.end4 ], [ %inc, %if.then ], [ 0, %entry ]
  %Phi1 = phi i32 [ %add, %if.end4 ], [ %Phi1, %if.then ], [ 0, %entry ]
  %lt = icmp slt i32 %Phi, 20
  br i1 %lt, label %while.body, label %while.end

while.body:                                       ; preds = %while.cond
  %inc = add i32 %Phi, 1
  %eq = icmp eq i32 %inc, 5
  br i1 %eq, label %if.then, label %if.end

while.end:                                        ; preds = %if.then3, %while.cond
  ret i32 0

if.then:                                          ; preds = %while.body
  %0 = call i32 (ptr, ...) @printf(ptr @.str.2)
  br label %while.cond

if.end:                                           ; preds = %while.body
  %add = add i32 100, %Phi1
  %1 = call i32 (ptr, ...) @printf(ptr @.str.1, i32 %add)
  %eq2 = icmp eq i32 %inc, 15
  br i1 %eq2, label %if.then3, label %if.end4

if.then3:                                         ; preds = %if.end
  %2 = call i32 (ptr, ...) @printf(ptr @.str)
  br label %while.end

if.end4:                                          ; preds = %if.end
  br label %while.cond
}

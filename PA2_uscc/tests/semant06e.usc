// Byounguk Min (min87@purdue.edu)
// Extended for semantic warning

int myFunc(int abc)
{
	int abc = 5;
    {
        int abc = 10;
    }
	return abc * 5;
}

int main()
{
    int a[30];
    a[31] = 333;
	return myFunc(10);
}

int main() {
	int a[3] = {1, 2, 3};
	int b[3] = {1, 2};
	int m[2][2] = {{1, 2}, {3, 4}};
	int e[2][2] = {1, 2, 3, 4};
	int u[] = {1, 2, 3};
	char s[] = "abc";
	return 0;
}

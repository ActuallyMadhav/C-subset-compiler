// Extended for semantic warning

int main()
{
	int a;
	a = "Stuff" && "Stuff";
	a = "Stuff" || "Stuff";
	a = "Stuff" + "Stuff";
	a = "Stuff" * "Stuff";
	a = "Stuff" < "Stuff";
	a = !"Stuff";
    if (a > 0) {
        int a = 40;
        int b;
        b[0] = 30;
    }
	return 0;
}

int main() {
    int constant = 100;
    int i = 0;
    int arr[4];
    while (i < 4) {
        arr[i] = constant + i;
        i = i + 1;
        if (constant == 100){
	   arr[2] = 5;
	}
    }
    printf("%d\n", arr[3]);
    return 0;
}


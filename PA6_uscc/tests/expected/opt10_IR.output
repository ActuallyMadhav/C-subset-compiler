; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @average(i32 %total, i32 %count, i32 %rounds) {
entry:
  %mul = mul i32 %total, 2
  %ne = icmp ne i32 %count, 0
  br label %for.cond

for.cond:                                         ; preds = %for.step, %entry
  %Phi1 = phi i32 [ %inc, %for.step ], [ 0, %entry ]
  %Phi4 = phi i32 [ %Phi8, %for.step ], [ 0, %entry ]
  %lt = icmp slt i32 %Phi1, %rounds
  br i1 %lt, label %for.body, label %for.end

for.body:                                         ; preds = %for.cond
  br i1 %ne, label %if.then, label %if.end

for.step:                                         ; preds = %if.end
  %inc = add i32 %Phi1, 1
  br label %for.cond

for.end:                                          ; preds = %for.cond
  ret i32 %Phi4

if.then:                                          ; preds = %for.body
  %div = sdiv i32 %mul, %count
  %add = add i32 %Phi4, %div
  br label %if.end

if.end:                                           ; preds = %if.then, %for.body
  %Phi8 = phi i32 [ %add, %if.then ], [ %Phi4, %for.body ]
  br label %for.step
}

define i32 @main() {
entry:
  %call = call i32 @average(i32 30, i32 0, i32 3)
  %0 = call i32 (ptr, ...) @printf(ptr @.str, i32 %call)
  %call1 = call i32 @average(i32 30, i32 5, i32 3)
  %1 = call i32 (ptr, ...) @printf(ptr @.str, i32 %call1)
  ret i32 0
}

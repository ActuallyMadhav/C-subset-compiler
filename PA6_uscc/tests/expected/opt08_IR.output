; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @sum(i32 %n, i32 %k) {
entry:
  %mul = mul i32 %k, 2
  %add = add i32 %mul, 1
  br label %for.cond

for.cond:                                         ; preds = %for.step, %entry
  %Phi1 = phi i32 [ %inc, %for.step ], [ 0, %entry ]
  %Phi3 = phi i32 [ %add4, %for.step ], [ 0, %entry ]
  %lt = icmp slt i32 %Phi1, %n
  br i1 %lt, label %for.body, label %for.end

for.body:                                         ; preds = %for.cond
  %add4 = add i32 %Phi3, %add
  br label %for.step

for.step:                                         ; preds = %for.body
  %inc = add i32 %Phi1, 1
  br label %for.cond

for.end:                                          ; preds = %for.cond
  ret i32 %Phi3
}

define i32 @main() {
entry:
  %call = call i32 @sum(i32 4, i32 5)
  %0 = call i32 (ptr, ...) @printf(ptr @.str, i32 %call)
  ret i32 0
}

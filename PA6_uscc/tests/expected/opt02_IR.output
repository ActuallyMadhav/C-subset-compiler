; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  br label %if.else

if.end:                                           ; preds = %if.else
  %0 = call i32 (ptr, ...) @printf(ptr @.str, i32 100)
  ret i32 0

if.else:                                          ; preds = %entry
  br label %if.end
}

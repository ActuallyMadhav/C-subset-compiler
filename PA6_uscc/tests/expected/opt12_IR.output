; ModuleID = 'main'
source_filename = "main"

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  br label %for.cond

for.cond:                                         ; preds = %for.step, %entry
  %Phi = phi i32 [ %inc, %for.step ], [ 0, %entry ]
  %Phi2 = phi i32 [ %add, %for.step ], [ 0, %entry ]
  %lt = icmp slt i32 %Phi, 5
  br i1 %lt, label %for.body, label %for.end

for.body:                                         ; preds = %for.cond
  br label %if.end

for.step:                                         ; preds = %if.end
  %inc = add i32 %Phi, 1
  br label %for.cond

for.end:                                          ; preds = %for.cond
  %0 = call i32 (ptr, ...) @printf(ptr @.str, i32 %Phi2)
  ret i32 0

if.end:                                           ; preds = %for.body
  %add = add i32 %Phi2, %Phi
  br label %for.step
}

int main() {
    int x = 10;
    int y = 5;
    int result = 0;
    int unused = 100; 

    while (y < 20) {
        result = result + x; 
        y = y + 1 ;
        if (x == 10){
           unused = 20;
	}
    }
    
    printf("%d\n", result);
    return 0;
}

